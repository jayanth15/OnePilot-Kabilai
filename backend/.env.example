# --- Application ---
APP_NAME=Kabilai API
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ---
# prod_db=true -> use DATABASE_URL (Postgres). prod_db=false -> local SQLite.
PROD_DB=false
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI Agent ---
# 'test' uses the deterministic TestModel. Use an OpenRouter model for real replies.
AGENT_MODEL=test
OPENROUTER_API_KEY=

# --- Gupshup WhatsApp ---
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=Kabilai
GUPSHUP_SOURCE_NUMBER=91XXXXXXXXXX
GUPSHUP_MOCK=true

# --- Admin login (seeded) ---
# Login: gopinath@kabilaifarm.com / Gopinath@12345!
