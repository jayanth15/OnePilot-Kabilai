# --- Application ---
APP_NAME=Kabilai API
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ---
# prod_db=true -> use DATABASE_URL (Postgres). prod_db=false -> local SQLite.
PROD_DB=false
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI Agent ---
# 'test' uses the deterministic TestModel. Use an OpenRouter model for real replies.
AGENT_MODEL=test
OPENROUTER_API_KEY=

# --- Gupshup WhatsApp ---
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=Kabilai
GUPSHUP_SOURCE_NUMBER=91XXXXXXXXXX
GUPSHUP_MOCK=true

# --- Meta WhatsApp Cloud API (official, Graph API v26.0 — latest, released Jul 29, 2026) ---
# WHATSAPP_PROVIDER=gupshup (default) or cloud. Set to cloud to send via Meta.
WHATSAPP_PROVIDER=gupshup
WHATSAPP_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_MOCK=true

# --- Admin login (seeded) ---
# Login: gopinath@kabilaifarm.com / Gopinath@12345!
